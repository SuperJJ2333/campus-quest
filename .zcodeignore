# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
build/
*.egg-info/

# Node
node_modules/
.next/
out/
# Managed by Next.js (regenerated by next dev/build); never edit or track it.
next-env.d.ts
# Incremental TypeScript build info from `tsc --noEmit`.
*.tsbuildinfo
npm-debug.log*

# Playwright e2e run artifacts (reports, traces, videos, results)
test-results/
playwright-report/
blob-report/

# Environment / secrets
.env
.env.*
!.env.example

# Agent worktrees and local session settings
.claude/worktrees/
.claude/settings.local.json

# Editor and OS cruft
.idea/
.vscode/
*.swp
.DS_Store

# agent stream scratch dirs (frontend S4 task workspaces)
.t*scratch/

